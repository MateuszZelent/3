SetGridSize(4096,8,4)
SetCellSize(2e-9,2e-9,2e-9)
Msat=800e3
Aex=13e-12
alpha=0.02
B_ext=Vector(0,0,0.02)
SetGeom(Cuboid(8192e-9,16e-9,8e-9).Sub(Cuboid(8e-9,4e-9,8e-9)))
m=Uniform(1,0,0)
for z:=0;z<4;z++ {
 for y:=0;y<8;y++ {
  for x:=2000;x<2120;x++ {
   m.SetCell(x,y,z,Vector(1,(x-2050)/10,y-3.5))
  }
 }
}
