{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite --debug dev --host",
		"build": "vite build && node scripts/sync-webui.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:production": "node scripts/test-production.mjs"
	},
	"type": "module",
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/echarts": "^4.9.22",
		"@types/eslint": "^9.6.1",
		"@types/eslint__js": "^8.42.3",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/prismjs": "^1.26.6",
		"@types/three": "^0.186.0",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"autoprefixer": "^10.6.2",
		"echarts": "^6.1.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prismjs": "^1.30.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"three": "^0.186.1",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"vitest": "^4.1.12"
	},
	"overrides": {
		"@eslint/plugin-kit@<0.3.4": "0.3.4",
		"ajv@<6.14.0": "6.14.0",
		"brace-expansion@<1.1.21": "1.1.21",
		"brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
		"brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
		"cookie@<0.7.0": "0.7.0",
		"devalue@>=5.0.0 <5.9.4": "5.9.4",
		"flatted@<3.4.2": "3.4.2",
		"js-yaml@>=4.0.0 <4.3.2": "4.3.2",
		"minimatch@<3.1.4": "3.1.4",
		"minimatch@>=9.0.0 <9.0.7": "9.0.7",
		"nanoid@>=3.0.0 <3.3.18": "3.3.18",
		"picomatch@<2.3.2": "2.3.2",
		"picomatch@>=4.0.0 <4.0.4": "4.0.4",
		"rollup@>=4.0.0 <4.59.0": "4.59.0",
		"yaml@>=1.0.0 <1.10.3": "1.10.3",
		"yaml@>=2.0.0 <2.8.3": "2.8.3",
		"postcss@<8.5.23": "8.5.23"
	},
	"packageManager": "npm@12.2.1"
}
