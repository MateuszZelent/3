// GPU regression for cell-centered absorbing layers on rectangular meshes.
EnableDemag = false
Msat = 800e3
Aex = 13e-12
alpha = .01
B_ext = vector(.1, 0, 0)

SetMesh(1024, 8, 1, 5e-9, 5e-9, 5e-9, 0, 0, 0)
m = uniform(1, 0, 0)
ext_SetAbsorbingBoundary(100e-9, .5, "x", "smootherstep", 0)
left := CropX(SpongeAlpha, 0, 1)
right := CropX(SpongeAlpha, 1023, 1024)
center := CropX(SpongeAlpha, 511, 513)
ExpectB("long X edge is damped", left.Average()[0] > 0, true)
Expect("long X symmetry", left.Average()[0], right.Average()[0], 1e-6)
Expect("long X bulk", center.Average()[0], 0, 0)
ext_SetAbsorbingBoundary(100e-9, .5, "x+", "power", 2)
Expect("unselected X edge", left.Average()[0], 0, 0)
ExpectB("selected X edge", right.Average()[0] > 0, true)
ext_AutoAbsorbingBoundary(20, "x", .5, 3)
ExpectB("automatic X edge", left.Average()[0] > 0, true)
Expect("automatic X symmetry", left.Average()[0], right.Average()[0], 1e-6)

SetMesh(8, 1024, 1, 5e-9, 5e-9, 5e-9, 0, 0, 0)
m = uniform(1, 0, 0)
ext_SetAbsorbingBoundary(100e-9, .5, "y", "tanh", 4)
bottom := CropY(SpongeAlpha, 0, 1)
top := CropY(SpongeAlpha, 1023, 1024)
center = CropY(SpongeAlpha, 511, 513)
ExpectB("long Y edge is damped", bottom.Average()[0] > 0, true)
Expect("long Y symmetry", bottom.Average()[0], top.Average()[0], 1e-6)
Expect("long Y bulk", center.Average()[0], 0, 0)
ext_AutoAbsorbingBoundaryAdvanced(12, 20, "y", "BV", .5, 20, 30, 0, 0, 0)
ExpectB("advanced Y edge", bottom.Average()[0] > 0, true)
Expect("advanced Y symmetry", bottom.Average()[0], top.Average()[0], 1e-6)

SetMesh(128, 128, 1, 5e-9, 5e-9, 5e-9, 0, 0, 0)
m = uniform(1, 0, 0)
ext_SetAbsorbingBoundary(100e-9, .5, "xy", "linear", 0)
corner := Crop(SpongeAlpha, 0, 1, 0, 1, 0, 1)
edge := Crop(SpongeAlpha, 0, 1, 63, 65, 0, 1)
center = Crop(SpongeAlpha, 63, 65, 63, 65, 0, 1)
ExpectB("square corner bounded", corner.Average()[0] <= .5, true)
ExpectB("square corner combines walls", corner.Average()[0] >= edge.Average()[0], true)
ExpectB("square edge active", edge.Average()[0] > 0, true)
Expect("square bulk", center.Average()[0], 0, 0)
ext_ClearAbsorbingBoundary()
Expect("clear removes extra damping", SpongeAlpha.Average(), 0, 0)
Flush()
