#!/usr/bin/env bash
# Check staged Go formatting without rewriting the index or working tree.
# Keep the full build gate for source/dependency/build-tool changes.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
needs_build=false
while IFS= read -r -d '' file; do
    case "$file" in
        doc/audits/*) continue ;; # Historical evidence is a separate module.
        *.go)
            needs_build=true
            # Deleted files still require a build, but cannot be formatted.
            if git cat-file -e ":$file" 2>/dev/null; then
                if ! unformatted=$(git show ":$file" | gofmt -l); then
                    printf 'pre-commit: invalid staged Go source: %s\n' "$file" >&2
                    exit 1
                fi
                if [[ -n "$unformatted" ]]; then
                    printf 'pre-commit: format and re-stage %s before committing.\n' "$file" >&2
                    exit 1
                fi
            fi
            ;;
        *.cu|*.cuh|*.c|*.h|go.mod|go.sum|Makefile|*/Makefile|justfile|pre-commit)
            needs_build=true
            ;;
    esac
done < <(git diff --cached --name-only --no-renames --diff-filter=ACDMRT -z)

if "$needs_build"; then
    make
fi
